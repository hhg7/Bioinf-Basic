use alienfile;
# Every tool is always installed into this distribution's own share directory:
# the point is a clustalo, BLAST, PLINK 2, bcftools, Prodigal, kallisto, SPAdes
# and Python that Cn::Bioinf controls, so there is no system probe. lib/Alien/Bioinf.pm does the fetching
# (and says where from), because update() has to do exactly the same thing
# again after install; this file only hands it the staging directory.
#
# Alien::Build insists on a download and an extract step, so those two just
# leave a marker behind. It is recorded as a local file, because a download
# with no protocol is one a future Alien::Build says it will refuse to extract.
#
# The build step runs in a temporary directory, so lib/ is found from where
# this file is, which is the working directory only while it is being loaded.
my $lib = Path::Tiny::path('lib')->absolute->stringify;
my $marker = sub {
	my ($build) = @_;
	my $f = Path::Tiny::path('tools');
	$f->spew('clustalo blast plink2 bcftools prodigal kallisto spades python');
	$build->install_prop->{download_detail}{ $f->absolute->stringify } = { protocol => 'file' };
};

probe sub { 'share' };

share {
	requires 'Alien::CPython3';
	requires 'Capture::Tiny';
	download $marker;
	extract $marker;
	build sub {
		my ($build) = @_;
		unshift @INC, $lib;
		require Alien::Bioinf;
		Alien::Bioinf->install($_, $build->install_prop->{stage}) foreach qw(clustalo blast python);
		# Each of these is built for fewer platforms than BLAST+ is (PLINK 2 has
		# no build for Linux on aarch64, say, and bcftools none for Windows), and
		# only some of Cn::Bioinf's functions need each, so one that cannot be
		# installed is left out and the rest is installed. SPAdes comes after
		# the Python above, which runs it.
		my %for = (
			plink2 => 'pgs_score and population-genetics functions', bcftools => 'call_variants',
			prodigal => 'predict_genes', kallisto => 'rnaseq_quant', spades => 'assemble',
		);
		foreach my $tool (qw(plink2 bcftools prodigal kallisto spades)) {
			eval { Alien::Bioinf->install($tool, $build->install_prop->{stage}); 1 }
				or warn "$tool was not installed, so Cn::Bioinf's $for{$tool} won't work: $@";
		}
	};
	gather sub {
		my ($build) = @_;
		unshift @INC, $lib;
		require Alien::Bioinf;
		my $v = Alien::Bioinf->versions($build->install_prop->{stage});
		$build->runtime_prop->{version} = join ', ', map { "$_ $v->{$_}" } sort keys %{ $v };
	};
};
